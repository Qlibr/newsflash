{
  "name": "qlibr/newsflash-rss-tests",
  "description": "PHPUnit tests for the Newsflash RSS WordPress plugin.",
  "license": "GPL-2.0-or-later",
  "type": "project",
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "phpcompatibility/php-compatibility": "dev-develop"
  },
  "config": {
    "allow-plugins": false
  },
  "scripts": {
    "test": "phpunit",
    "compat": [
      "phpcs --config-set installed_paths vendor/phpcompatibility/php-compatibility,vendor/phpcsstandards/phpcsutils",
      "phpcs --standard=phpcs.xml.dist"
    ]
  }
}
